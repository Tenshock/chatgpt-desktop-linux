#!/usr/bin/env bash
set -euo pipefail

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
repo_root=$(cd -- "$script_dir/.." && pwd)

updater=$(nix build \
  --no-link \
  --print-out-paths \
  "$repo_root#updater")

exec "$updater/bin/update-chatgpt-source" \
  --source-dir "$repo_root/nix" \
  --write \
  "$@"
